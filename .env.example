# ---------------------------------------------------------------------------
# FR3SHU Organic POS — environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
# This app has NO database of its own and NO local JWT. go-api-backend owns the
# entire POS runtime (seller tenancy, catalogue, inventory, registers, shifts,
# sales, tenders, returns, invoices). Authentication is Supabase Auth via
# @supabase/ssr cookie sessions; the Go API is the authorization + business
# boundary and every privileged call carries the Supabase access token as
# `Authorization: Bearer`.
# ---------------------------------------------------------------------------

# ─── Go API (REQUIRED) ──────────────────────────────────────────────────────
# The browser bundle calls this directly for Supabase-authenticated endpoints
# (/auth/reconcile, /onboarding, /seller-organizations, ...). POS register/shift/
# sale calls additionally go through this app's same-origin /api/v1/pos/* proxy.
# Use the ORIGIN only — do not append /api/v1.
NEXT_PUBLIC_API_BASE_URL=https://your-go-api-backend.example.com
# Server-only override for the /api/v1/pos/* proxy (optional; defaults to the
# public value above).
# GO_API_BASE_URL=http://127.0.0.1:8080

# ─── Supabase Auth (REQUIRED) ──────────────────────────────────────────────
# Public project URL + publishable/anon key. The service-role key must NEVER be
# added to this app.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>
# Legacy name still accepted as a fallback:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# This app's canonical public URL (used for the OAuth redirectTo).
APP_URL=https://pos.example.com

# ─── Provider flags ────────────────────────────────────────────────────────
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_WHATSAPP_ENABLED=false

# App
NEXT_PUBLIC_APP_NAME="FR3SHU Organic POS"

# ---------------------------------------------------------------------------
# Removed after the Go cutover — delete these from any local .env.local:
#   MONGODB_URI                 (this app has no database)
#   JWT_SECRET / JWT_EXPIRES_IN / JWT_COOKIE_MAX_AGE   (no local JWT; the old
#                               pos_token cookie is gone — Supabase owns sessions)
#   BCRYPT_SALT_ROUNDS          (password hashing is owned by Supabase)
#   POS_CASH_VARIANCE_NOTE_THRESHOLD_PAISE  (now in go-api-backend)
#   NEXT_PUBLIC_CATALOGUE_API_BASE_URL      (folded into NEXT_PUBLIC_API_BASE_URL)
#   SEED_ADMIN_* / SEED_OWNER_* / SEED_CASHIER_*  (seed script removed)
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# ---------------------------------------------------------------------------
