NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_AUTH_KEY
NEXT_PUBLIC_SUPABASE_SUPABASE_AVATAR_URL=https://YOUR_PROJECT.supabase.co/storage/v1/object/public/avatars/
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_WMS_BUCKET=wms-uploads
