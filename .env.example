# Server-side proxy target (preferred). All browser data calls use /api/v1/*.
GO_API_BASE_URL=http://localhost:8080
# Optional public alias; no database URL or backend keys belong here.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_AUTH_KEY
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_WHATSAPP_ENABLED=false
NEXT_PUBLIC_APP_NAME=KOMOLA POS
APP_URL=http://localhost:3000
