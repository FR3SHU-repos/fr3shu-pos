# ---------------------------------------------------------------------------
# FR3SHU Organic POS — environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# MongoDB — use a database that is isolated from the other FR3SH apps.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fr3sh_pos?retryWrites=true&w=majority"

# Auth
JWT_SECRET="<generate-a-long-random-string>"
JWT_EXPIRES_IN=8h
JWT_COOKIE_MAX_AGE=28800
BCRYPT_SALT_ROUNDS=12

# API client boundary.
# Empty => the browser talks to this app's own /api/v1 route handlers.
# Later, point this at the FR3SH Go/Gin service (e.g. https://api.fr3sh.example) to swap
# the backend without touching UI code.
NEXT_PUBLIC_API_BASE_URL=
# Incremental migration flag: point catalogue GETs at go-api-backend while POS
# authentication and mutation endpoints remain on the legacy base.
NEXT_PUBLIC_CATALOGUE_API_BASE_URL=https://fr3shu-go-backend-api.onrender.com

# App
NEXT_PUBLIC_APP_NAME="FR3SHU Organic POS"

# Register close: variance (in paise) above which a reason note is mandatory. 20000 = ₹200.
POS_CASH_VARIANCE_NOTE_THRESHOLD_PAISE=20000

# --- Optional / deferred (not used in the thin slice) ---
# Rate limiting (Upstash). If unset, the login guard falls back to a documented no-op.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Seed script — dev-only credentials. If unset, seed.ts generates and prints them.
# SEED_ADMIN_EMAIL=admin@fr3shu.local
# SEED_ADMIN_PASSWORD=
# SEED_OWNER_EMAIL=owner@greenharvest.local
# SEED_OWNER_PASSWORD=
# SEED_CASHIER_EMAIL=cashier@greenharvest.local
# SEED_CASHIER_PASSWORD=
