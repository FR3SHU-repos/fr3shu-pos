# ---------------------------------------------------------------------------
# FR3SHU Organic POS — environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#
# This app has NO database of its own. go-api-backend owns the entire POS
# runtime (catalogue, inventory, registers, shifts, sales, tenders, returns).
# ---------------------------------------------------------------------------

# Canonical API. REQUIRED. The browser calls this app's same-origin
# /api/v1/pos/* proxy, which relays to <GO_API_BASE_URL>/api/v1/pos/*.
# NEXT_PUBLIC_API_BASE_URL is the public value used by the browser bundle;
# GO_API_BASE_URL (server-only, optional) overrides it for the proxy.
NEXT_PUBLIC_API_BASE_URL=https://your-go-api-backend.example.com
# GO_API_BASE_URL=http://127.0.0.1:8080

# Server-side session decode for the SSR redirect on "/". Must match the
# JWT_SECRET configured in go-api-backend so the pos_token cookie verifies.
JWT_SECRET="<same-long-random-string-as-go-api-backend>"
JWT_COOKIE_MAX_AGE=28800

# App
NEXT_PUBLIC_APP_NAME="FR3SHU Organic POS"

# ---------------------------------------------------------------------------
# Obsolete after the Go cutover — safe to delete from your local .env.local:
#   MONGODB_URI                 (no database in this app anymore)
#   JWT_EXPIRES_IN              (token lifetime is owned by go-api-backend)
#   BCRYPT_SALT_ROUNDS          (password hashing is owned by go-api-backend)
#   POS_CASH_VARIANCE_NOTE_THRESHOLD_PAISE  (now POS_CASH_VARIANCE_NOTE_THRESHOLD_PAISE in go-api-backend)
#   NEXT_PUBLIC_CATALOGUE_API_BASE_URL      (folded into NEXT_PUBLIC_API_BASE_URL)
#   SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD / SEED_OWNER_* / SEED_CASHIER_*  (seed script removed)
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# ---------------------------------------------------------------------------
